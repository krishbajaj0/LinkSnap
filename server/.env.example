NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set this locally to your MongoDB connection string, including the database name.
MONGODB_URI=
# Generate 32 random bytes as hex and store them only in the local .env.
AUTH_SECRET=
# Optional, separate 32-byte random hex key for approximate unique visitors.
ANALYTICS_VISITOR_SECRET=
# Optional path to a local GeoIP Country or City .mmdb file.
ANALYTICS_GEOIP_PATH=
# Leave blank unless exact, controlled reverse-proxy IPs are known.
TRUSTED_PROXY_IPS=
# Optional comma-separated domain blocklist maintained by the deployment operator.
PROHIBITED_LINK_DOMAINS=
